<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_invoice_document"
        inherit_id="account.report_invoice_document"
        priority="1000"
    >
        <xpath expr="//t[@t-set='forced_vat']" position="after">
            <t
                t-set="verifactu_invoice"
                t-value="o.verifactu_enabled and o.verifactu_qr"
            />
        </xpath>
        <!-- The QR is rendered at the top of the document body, right below the
             address block laid out by `web.address_layout`. We deliberately do
             not inherit `web.address_layout` (as done up to 18.0): it is shared
             by every report and its internal structure changed in 19.0. -->
        <xpath expr="//div[hasclass('invoice_main')]" position="before">
            <div
                id="verifactu_row"
                class="row mb-4"
                t-if="verifactu_invoice"
                style="page-break-inside:avoid;"
            >
                <div id="verifactu" class="col-3 text-center">
                    <strong class="d-block">QR Tributario</strong>
                    <img
                        id="verifactu_qr"
                        t-attf-src="data:image/png;base64,{{o.verifactu_qr}}"
                        style="min-width: 40mm; max-width: 40mm"
                        alt="VERI*FACTU QR"
                    />
                    <strong class="d-block">VERI*FACTU</strong>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
